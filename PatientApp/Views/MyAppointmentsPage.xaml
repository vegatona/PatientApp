<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PatientApp.Views.MyAppointmentsPage"
             Title="Mis Citas"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="15">

        <!-- Pestañas Próximas / Historial -->
        <Grid Grid.Row="0" ColumnDefinitions="*, *" ColumnSpacing="10">
            <Button x:Name="BtnProximas"
                    Grid.Column="0"
                    Text="Próximas"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Clicked="OnProximasClicked" />

            <Button x:Name="BtnHistorial"
                    Grid.Column="1"
                    Text="Historial"
                    BackgroundColor="White"
                    TextColor="Gray"
                    BorderColor="#D1D5DB"
                    BorderWidth="1"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Clicked="OnHistorialClicked" />
        </Grid>

        <!-- Lista de Próximas Citas -->
        <CollectionView x:Name="UpcomingList" Grid.Row="1" IsVisible="True">
            <CollectionView.EmptyView>
                <Label Text="No tienes citas próximas agendadas."
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="Gray" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" Padding="15" Margin="0,0,0,12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding Status}" BackgroundColor="#FEF3C7" TextColor="#D97706" FontSize="11" FontAttributes="Bold" Padding="6,2" />
                                <Label Text="{Binding Folio}" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Label FontSize="17" FontAttributes="Bold" TextColor="#111111">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0} • {1}">
                                        <Binding Path="Date" />
                                        <Binding Path="Time" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>

                            <Label Text="{Binding ClinicName}" FontSize="14" FontAttributes="Bold" TextColor="#333333" />
                            <Label Text="{Binding Specialty}" FontSize="13" TextColor="Gray" />

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                                <Button Grid.Column="0"
                                        Text="Reprogramar"
                                        BackgroundColor="White"
                                        TextColor="#2563EB"
                                        BorderColor="#2563EB"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        HeightRequest="40"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnReprogramarClicked" />

                                <Button Grid.Column="1"
                                        Text="Cancelar"
                                        BackgroundColor="#FEE2E2"
                                        TextColor="#DC2626"
                                        CornerRadius="8"
                                        HeightRequest="40"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnCancelarClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Lista de Historial (Citas Cumplidas y Canceladas) -->
        <CollectionView x:Name="PastList" Grid.Row="1" IsVisible="False">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" Padding="15" Margin="0,0,0,12" Opacity="0.9">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding Status}"
                                       BackgroundColor="{Binding StatusBgColor}"
                                       TextColor="{Binding StatusTextColor}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       Padding="6,2" />
                                <Label Text="{Binding Folio}" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Label FontSize="16" FontAttributes="Bold" TextColor="#111111">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0} • {1}">
                                        <Binding Path="Date" />
                                        <Binding Path="Time" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>

                            <Label Text="{Binding ClinicName}" FontSize="14" FontAttributes="Bold" TextColor="#333333" />
                            <Label Text="{Binding Specialty}" FontSize="13" TextColor="Gray" />

                            <!-- Motivo de cancelación (solo visible si fue cancelada) -->
                            <Label Text="{Binding CancelReason, StringFormat='Motivo: {0}'}"
                                   IsVisible="{Binding HasCancelReason}"
                                   FontSize="12"
                                   TextColor="#DC2626"
                                   FontAttributes="Italic" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Modal personalizado de Cancelación -->
        <Grid x:Name="CancelModalOverlay"
              Grid.RowSpan="2"
              BackgroundColor="#80000000"
              IsVisible="False"
              Margin="-20">

            <Border BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="20"
                    Margin="25"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Cancelar Cita"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#111111" />

                    <Label x:Name="LblCancelInfo"
                           FontSize="14"
                           TextColor="Gray" />

                    <Entry x:Name="EntryCancelReason"
                           Placeholder="Ej. Surgió un imprevisto..."
                           BackgroundColor="#F3F4F6"
                           TextColor="Black"
                           TextChanged="OnCancelReasonChanged" />

                    <!-- Mensaje rojo obligatorio -->
                    <Label x:Name="LblCancelError"
                           Text="* El motivo de cancelación es obligatorio."
                           FontSize="12"
                           TextColor="#DC2626"
                           IsVisible="True" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Text="Volver"
                                BackgroundColor="#F3F4F6"
                                TextColor="#374151"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="42"
                                Clicked="OnCerrarModalClicked" />

                        <Button x:Name="BtnConfirmarCancelacion"
                                Grid.Column="1"
                                Text="Confirmar"
                                BackgroundColor="#D1D5DB"
                                TextColor="#6B7280"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="42"
                                IsEnabled="False"
                                Clicked="OnConfirmarCancelacionClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>