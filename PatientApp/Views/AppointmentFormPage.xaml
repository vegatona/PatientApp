<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PatientApp.Views.AppointmentFormPage"
             Title="Agendar Cita"
             BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Datos Generales"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#111111" />

            <!-- Nombre(s) -->
            <Label Text="Nombre(s)" FontSize="13" TextColor="Gray" />
            <Entry x:Name="EntryNombre" Placeholder="Ej. Jesús Oswaldo" BackgroundColor="White" TextColor="Black" />

            <!-- Apellidos en dos columnas -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Apellido Paterno" FontSize="13" TextColor="Gray" />
                    <Entry x:Name="EntryPaterno" Placeholder="Ej. Vega" BackgroundColor="White" TextColor="Black" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Apellido Materno" FontSize="13" TextColor="Gray" />
                    <Entry x:Name="EntryMaterno" Placeholder="Ej. Tona" BackgroundColor="White" TextColor="Black" />
                </VerticalStackLayout>
            </Grid>

            <!-- Edad y Especialidad -->
            <Grid ColumnDefinitions="100, *" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Edad" FontSize="13" TextColor="Gray" />
                    <Entry x:Name="EntryEdad" Placeholder="Ej. 22" Keyboard="Numeric" MaxLength="3" BackgroundColor="White" TextColor="Black" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Especialidad" FontSize="13" TextColor="Gray" />
                    <Picker x:Name="PickerEspecialidad" Title="Selecciona..." BackgroundColor="White" TextColor="Black" />
                </VerticalStackLayout>
            </Grid>

            <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,10" />

            <!-- Sección de Horarios Disponibles -->
            <Label Text="Horarios Disponibles"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#111111" />

            <!-- Selector de Día -->
            <Label Text="1. Selecciona un día disponible" FontSize="13" TextColor="Gray" />
            <Picker x:Name="PickerDia"
                    Title="Elige una fecha"
                    BackgroundColor="White"
                    TextColor="Black"
                    SelectedIndexChanged="OnDiaSelected">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>19/11/2026</x:String>
                        <x:String>20/11/2026</x:String>
                        <x:String>21/11/2026</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <!-- Selector de Hora (se llena según el día) -->
            <Label Text="2. Selecciona una hora" FontSize="13" TextColor="Gray" Margin="0,5,0,0" />
            <Picker x:Name="PickerHora"
                    Title="Primero elige un día..."
                    BackgroundColor="White"
                    TextColor="Black"
                    IsEnabled="False" />

            <!-- Botón Confirmar -->
            <Button Text="Confirmar y Agendar"
                    BackgroundColor="#10B981"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,20,0,10"
                    Clicked="OnConfirmarClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>