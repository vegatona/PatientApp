<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PatientApp.Views.RegisterPage"
             Title="Crear Cuenta"
             BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Datos de Acceso" FontSize="18" FontAttributes="Bold" TextColor="#111111" />

            <Label Text="Correo Electrónico" FontSize="13" TextColor="Gray" />
            <Entry x:Name="EntryEmail" Placeholder="correo@ejemplo.com" Keyboard="Email" BackgroundColor="White" TextColor="Black" />

            <Label Text="Contraseña" FontSize="13" TextColor="Gray" />
            <Entry x:Name="EntryPassword" Placeholder="Crea una contraseña" IsPassword="True" BackgroundColor="White" TextColor="Black" />

            <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,8" />

            <Label Text="Datos Personales" FontSize="18" FontAttributes="Bold" TextColor="#111111" />

            <Label Text="Nombre(s)" FontSize="13" TextColor="Gray" />
            <Entry x:Name="EntryNombre" Placeholder="Ej. Juan Carlos" BackgroundColor="White" TextColor="Black" />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Apellido Paterno" FontSize="13" TextColor="Gray" />
                    <Entry x:Name="EntryPaterno" Placeholder="Ej. Pérez" BackgroundColor="White" TextColor="Black" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Apellido Materno" FontSize="13" TextColor="Gray" />
                    <Entry x:Name="EntryMaterno" Placeholder="Ej. Ruiz" BackgroundColor="White" TextColor="Black" />
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*, 100" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Teléfono" FontSize="13" TextColor="Gray" />
                    <Entry x:Name="EntryTelefono" Placeholder="644 123 4567" Keyboard="Telephone" BackgroundColor="White" TextColor="Black" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Edad" FontSize="13" TextColor="Gray" />
                    <Entry x:Name="EntryEdad" Placeholder="25" Keyboard="Numeric" MaxLength="3" BackgroundColor="White" TextColor="Black" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="Alergias" FontSize="13" TextColor="Gray" />
            <Entry x:Name="EntryAlergias" Placeholder="Ej. Ninguna, Penicilina..." BackgroundColor="White" TextColor="Black" />

            <Label Text="Condición(es) médica(s) (Opcional)" FontSize="13" TextColor="Gray" />
            <Editor x:Name="EditorCondiciones" Placeholder="Ej. Diabetes, Hipertensión..." HeightRequest="70" BackgroundColor="White" TextColor="Black" />

            <Button Text="Registrarme"
                    BackgroundColor="#10B981"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,15,0,20"
                    Clicked="OnRegisterClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>