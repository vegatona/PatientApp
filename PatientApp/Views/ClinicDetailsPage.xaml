<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PatientApp.Views.ClinicDetailsPage"
             Title="Detalles de la Clínica"
             BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label x:Name="LblNombre"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#111111" />

            <!-- Ubicación -->
            <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="5">
                    <Label Text="📍 Ubicación" FontSize="16" FontAttributes="Bold" TextColor="#333333" />
                    <Label x:Name="LblUbicacion" FontSize="14" TextColor="Gray" />
                </VerticalStackLayout>
            </Border>

            <!-- Especialidades -->
            <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="5">
                    <Label Text="🩺 Especialidades Disponibles" FontSize="16" FontAttributes="Bold" TextColor="#333333" />
                    <Label x:Name="LblEspecialidades" FontSize="14" TextColor="Gray" />
                </VerticalStackLayout>
            </Border>

            <!-- Horarios -->
            <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="5">
                    <Label Text="🕒 Horarios de Atención" FontSize="16" FontAttributes="Bold" TextColor="#333333" />
                    <Label x:Name="LblHorarios" FontSize="14" TextColor="Gray" />
                </VerticalStackLayout>
            </Border>

            <!-- Botón para ir al Formulario de Cita -->
            <Button Text="Agendar Cita"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,15,0,0"
                    Clicked="OnAgendarCitaClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>