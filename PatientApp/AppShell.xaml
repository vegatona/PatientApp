<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PatientApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PatientApp.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="Medical Staff">

    <TabBar>
        <!-- Tab 1: Explorar Clínicas -->
        <Tab Title="Explorar" Icon="search_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:ExplorePage}" />
        </Tab>

        <!-- Tab 2: Mis Citas -->
        <Tab Title="Mis Citas" Icon="calendar_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:MyAppointmentsPage}" />
        </Tab>

        <!-- Tab 3: Mi Perfil -->
        <Tab Title="Perfil" Icon="profile_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>
    </TabBar>

</Shell>